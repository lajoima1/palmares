{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "palmares",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-05",
  // A page address with no file, like /recipe/pate-chinois, gets index.html. A fetch with no file
  // (an /api/ call, a missing photo) still reaches the Worker.
  "assets": { "directory": "./dist/", "not_found_handling": "single-page-application" },
  // Passkeys and users. The namespace "palmares-auth" was made in the dashboard. The ID is not a secret.
  "kv_namespaces": [{ "binding": "AUTH", "id": "5d928eebc159415fa220962f37301add" }],
  // Workers AI reads a recipe from a photo or a page. The free plan gives 10,000 neurons a day,
  // about 100 reads, and cannot bill more.
  "ai": { "binding": "AI" },
  // .dev.vars overrides these in a local run. The secrets GITHUB_TOKEN, SESSION_SECRET,
  // SETUP_CODE and GEMINI_API_KEY are Worker secrets in the dashboard, never in this file.
  "vars": {
    "ORIGIN": "https://palmares.lajoie.workers.dev",
    "RP_ID": "palmares.lajoie.workers.dev",
    "GITHUB_REPO": "lajoima1/palmares",
    "GITHUB_BRANCH": "main",
    // The end date of GITHUB_TOKEN, like "2027-11-06". The admin page warns 30 days before it.
    // Empty: the token has no end date, and the page shows no warning.
    "TOKEN_EXPIRES": ""
  },
  // `wrangler dev --env local`: no AI binding, so no Cloudflare sign-in. A local read uses only
  // Gemini, with GEMINI_API_KEY in .dev.vars. An environment inherits no binding and no var, so
  // both repeat here.
  "env": {
    "local": {
      "kv_namespaces": [{ "binding": "AUTH", "id": "5d928eebc159415fa220962f37301add" }],
      "vars": {
        "ORIGIN": "http://localhost:8787",
        "RP_ID": "localhost",
        "GITHUB_REPO": "lajoima1/palmares",
        "GITHUB_BRANCH": "admin-test",
        "TOKEN_EXPIRES": ""
      }
    }
  }
}
